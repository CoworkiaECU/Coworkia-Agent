# ============================================
# 🚨 CONFIGURACIÓN LOCAL - CONECTA A HEROKU
# ============================================
# 
# COPIA ESTE ARCHIVO A .env.local y configura tus valores
# 
# ⚠️ IMPORTANTE: Esta app usa UNA SOLA base de datos (PostgreSQL en Heroku)
# Para desarrollo local, debes conectarte a la base de datos de Heroku
#
# Para obtener DATABASE_URL:
#   heroku config:get DATABASE_URL -a coworkia-agent
#
# ============================================

# Base de datos (REQUERIDO - PostgreSQL en Heroku)
DATABASE_URL=postgresql://usuario:password@host:5432/database

# OpenAI API
OPENAI_API_KEY=sk-...

# Wassenger WhatsApp
WASSENGER_API_KEY=...
WASSENGER_DEVICE_ID=...
WASSENGER_WEBHOOK_SECRET=...

# Google Calendar
GOOGLE_CALENDAR_ID=...
GOOGLE_SERVICE_ACCOUNT_EMAIL=...
GOOGLE_SERVICE_ACCOUNT_KEY=...

# Gmail (opcional para notificaciones)
GMAIL_USER=...
GMAIL_APP_PASSWORD=...

# Puerto local
PORT=3000

# Entorno (déjalo en development para ver logs detallados)
NODE_ENV=development
